# LLM provider
GOOGLE_API_KEY=replace-with-your-google-api-key

# PostgreSQL
POSTGRES_USER=tfg
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=tfg
POSTGRES_HOST=db_postgres
POSTGRES_PORT=5432

# Comma-separated frontend origins allowed to call the API.
# With Nginx in production, browser requests are same-origin through /api.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
